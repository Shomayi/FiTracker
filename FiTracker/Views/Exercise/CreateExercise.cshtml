@{
    ViewData["Title"] = "Create Exercise";
}

@model FiTracker.ViewModels.ExerciseViewModel

<div class="text-center">
    <h1 class="display-4">Create exercise</h1>
    @{
        var successMessage = TempData["SuccessMessage"] as string;
        var errorMessage = TempData["ErrorMessage"] as string;
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3" role="alert">
            @Html.Raw(successMessage)
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            @Html.Raw(errorMessage)
        </div>
    }
</div>

<form asp-action="CreateExercise" asp-controller="Exercise" method="post">
    @Html.AntiForgeryToken()
    <label class="mt-4">Name</label>
    <input class="form-control" type="text" placeholder="Add exercise name" asp-for="Name" />

    <label class="mt-4">Weight</label>
    <input class="form-control" type="number" step="0.1" placeholder="0" asp-for="Weight"/>

    <label class="mt-4">Sets</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Sets"/>

    <label class="mt-4">Reps</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Reps" />

    <div class="mt-4 d-flex gap-2">
    <button class="btw btn-primary" type="submit">Confirm</button>
    <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#discardModal">
        Discard Changes
    </button>
    </div>
</form>

<div class="modal fade" id="discardModal" tabindex="-1" aria-labelledby="discardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="discardModalLabel">Discard Changes?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to discard your changes? Any unsaved changes will be lost
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a asp-action="Exercises" asp-controller="Exercise" class="btn btn-danger">Discard</a>
            </div>
        </div>
    </div>
</div>

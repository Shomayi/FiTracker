@{
    ViewData["Title"] = "Edit Exercise";
}

@model FiTracker.ViewModels.ExerciseViewModel
<div class="text-center">
    <h1 class="display-4">Edit exercise</h1>
    @{
        var successMessage = TempData["SuccessMessage"] as string;
        var errorMessage = TempData["ErrorMessage"] as string;
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3" role="alert">
            @Html.Raw(successMessage)
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            @Html.Raw(errorMessage)
        </div>
    }
</div>

<form asp-action="EditExercise" asp-controller="Exercise" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <label class="mt-4">Name</label>
    <input class="form-control" type="text" placeholder="Add exercise name" asp-for="Name" />

    <label class="mt-4">Weight</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Weight" />

    <label class="mt-4">Sets</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Sets" />

    <label class="mt-4">Reps</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Reps" />

    <button class="btw btn-primary mt-4" type="submit">Save Changes</button>

</form>

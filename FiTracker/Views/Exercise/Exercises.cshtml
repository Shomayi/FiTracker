
@{
    ViewData["Title"] = "Exercises";
}

@model List<FiTracker.ViewModels.ExerciseViewModel>

<div class="text-center">
    <h1 class="display-4">Exercises</h1>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <a asp-action="CreateExercise" class="btn btn-primary">Add</a>
    <br />
    <table class="table">
        <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Weight
                </th>
                <th>
                    Sets
                </th>
                <th>
                    Reps
                </th>
                <th>
                    Edit
                </th>
                <th>
                    Delete
                </th>
            </tr>
        </thead>   
        <tbody>
            @{
                foreach (var exercise in Model)
                {
                    <tr>
                        <td>
                            @exercise.Name
                        </td>
                        <td>
                            @(exercise.Weight.HasValue? (exercise.Weight.Value == 0 ? "Bodyweight" : exercise.Weight.Value.ToString("0.#")): "")
                        </td>
                        <td>
                            @exercise.Sets
                        </td>
                        <td>
                            @exercise.Reps
                        </td>
                        <td>
                            <a asp-action="EditExercise" asp-route-id="@exercise.Id" class="btn btn-primary btn-sm">Edit</a>
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@exercise.Id">X</button>
                            <div class="modal fade" id="deleteModal-@exercise.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@exercise.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="deleteModalLabel-@exercise.Id">Confirm Delete</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete the exercise "@exercise.Name"?
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <form asp-action="DeleteExercise" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@exercise.Id" />
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


